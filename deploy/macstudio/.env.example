# Copy to .env, replace every placeholder, then chmod 600 .env.
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE

# External S3-compatible storage is mandatory. Local MinIO is intentionally unsupported.
BUZZ_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
BUZZ_S3_REGION=ap-southeast-1
BUZZ_S3_BUCKET=REPLACE_WITH_BUCKET
BUZZ_S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
BUZZ_S3_SECRET_KEY=REPLACE_WITH_SECRET_KEY

# Confirm only after the Mac Studio, router, and switch are connected to a UPS.
BUZZ_UPS_CONFIRMED=false

# Sipher LAN self-registration contract. Preflight requires both values to
# remain false; restrict TCP 8443 to the trusted LAN/VPN perimeter.
RELAY_URL=wss://buzz.sipher.gg:8443
BUZZ_REQUIRE_AUTH_TOKEN=false
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false
# BUZZ_RELAY_PRIVATE_KEY=<64-character-hex-private-key>

# Bind to a trusted LAN interface or Tailscale address where possible.
BUZZ_BIND_IP=0.0.0.0
BUZZ_HTTP_PORT=3000
RUST_LOG=buzz_relay=info,tower_http=info
